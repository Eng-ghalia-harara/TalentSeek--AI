# Copy this file to .env and replace the placeholder values.
DB_HOST=localhost
DB_PORT=5433
DB_CONNECT_TIMEOUT=5
DB_NAME=your_database_name
DB_USER=your_postgres_user
DB_PASS=replace_with_your_database_password

GEMINI_API_KEY=replace_with_your_gemini_api_key
# Optional additional Gemini key; further keys may use GEMINI_API_KEY2, GEMINI_API_KEY3, etc.
GEMINI_API_KEY1=replace_with_an_additional_gemini_api_key

# Groq powers answer generation only. Add extra keys as GROQ_API_KEY1, GROQ_API_KEY2, etc.
# Alternatively, provide a comma-separated GROQ_API_KEYS list.
GROQ_API_KEY=replace_with_your_groq_api_key
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIM=768
GENERATION_MODEL=openai/gpt-oss-120b
TOKEN_COUNT_MODEL=gemini-3.1-flash-lite

ADMIN_PASSWORD=replace_with_a_strong_admin_password
RECRUITER_PASSWORD=replace_with_a_different_recruiter_password

MAX_UPLOAD_MB=15
MAX_PDF_PAGES=30
MIN_EXTRACTED_CHARS=100
MAX_SECTION_TOKENS=6000
DEFAULT_TOP_K=3
RETRIEVAL_FETCH_K=40
MAX_EVIDENCE_PER_CANDIDATE=2

STORAGE_DIR=storage/cvs
STAGING_DIR=storage/staging
REPORTS_DIR=reports
CACHE_DIR=cache
